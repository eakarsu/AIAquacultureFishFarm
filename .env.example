NODE_ENV=development
BACKEND_PORT=3095
FRONTEND_PORT=3094
ALLOWED_ORIGINS=http://localhost:3094
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aquaculture_farm
DB_USER=postgres
DB_PASSWORD=replace-me
DB_SSL=false
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/aquaculture_farm
JWT_SECRET=replace-with-at-least-32-random-characters
DEFAULT_TENANT_ID=default
OPENROUTER_API_KEY=
ENABLE_EXPERIMENTAL_AI=false
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_VIEWER_PASSWORD=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
